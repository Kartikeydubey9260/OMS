{
    "name": "oms/monorepo",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "OMS\\Core\\": "packages/OMS/Core/src",
            "OMS\\Users\\": "packages/OMS/Users/src",
            "OMS\\Customers\\": "packages/OMS/Customers/src",
            "OMS\\Products\\": "packages/OMS/Products/src",
            "OMS\\Inventory\\": "packages/OMS/Inventory/src",
            "OMS\\Orders\\": "packages/OMS/Orders/src",
            "OMS\\Admin\\": "packages/OMS/Admin/src",
            "OMS\\API\\": "packages/OMS/API/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "OMS\\Core\\Tests\\": "packages/OMS/Core/tests/",
            "OMS\\Users\\Tests\\": "packages/OMS/Users/tests/",
            "OMS\\Customers\\Tests\\": "packages/OMS/Customers/tests/",
            "OMS\\Products\\Tests\\": "packages/OMS/Products/tests/",
            "OMS\\Inventory\\Tests\\": "packages/OMS/Inventory/tests/",
            "OMS\\Orders\\Tests\\": "packages/OMS/Orders/tests/",
            "OMS\\Admin\\Tests\\": "packages/OMS/Admin/tests/",
            "OMS\\API\\Tests\\": "packages/OMS/API/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \\\"file_exists('.env') || copy('.env.example', '.env');\\\"",
            "@php artisan key:generate --ansi",
            "@php artisan migrate --seed --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=api,queue,web"
        ],
        "build": "npm run build",
        "lint": [
            "pint --test",
            "npm run lint"
        ],
        "fix": [
            "pint",
            "npm run format"
        ],
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "test": [
            "@php artisan config:clear --ansi",
            "pest --compact"
        ],
        "test:unit": "npm run test:unit",
        "test:e2e": "npm run e2e",
        "qa": "bash qa-kit/scripts/qa/run-all.sh",
        "qa:dry": "bash qa-kit/scripts/qa/dry-run.sh 2"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
