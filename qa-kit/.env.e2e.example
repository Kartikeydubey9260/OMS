# Copy to .env.e2e (git-ignored). Used by Pest-independent e2e runs: APP_ENV=e2e loads .env.e2e
APP_NAME=OMS-E2E
APP_ENV=e2e
APP_KEY=
APP_DEBUG=false
# Laravel serves API *and* the built React SPA on one origin -> no CORS needed
APP_URL=http://localhost:8001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oms_e2e
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
MAIL_MAILER=log

# relaxed throttles ONLY for e2e (production defaults: login 5/min per email+IP, api 120/min)
OMS_LOGIN_THROTTLE=100000
OMS_API_THROTTLE=100000
OMS_TAX_RATE=10
