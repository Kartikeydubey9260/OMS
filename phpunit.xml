<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="false">
  <testsuites>
    <testsuite name="Root"><directory>tests</directory></testsuite>
    <testsuite name="OMS Core"><directory>packages/OMS/Core/tests</directory></testsuite>
    <testsuite name="OMS Users"><directory>packages/OMS/Users/tests</directory></testsuite>
    <testsuite name="OMS Customers"><directory>packages/OMS/Customers/tests</directory></testsuite>
    <testsuite name="OMS Products"><directory>packages/OMS/Products/tests</directory></testsuite>
    <testsuite name="OMS Inventory"><directory>packages/OMS/Inventory/tests</directory></testsuite>
    <testsuite name="OMS Orders"><directory>packages/OMS/Orders/tests</directory></testsuite>
    <testsuite name="OMS Admin"><directory>packages/OMS/Admin/tests</directory></testsuite>
    <testsuite name="OMS API"><directory>packages/OMS/API/tests</directory></testsuite>
    <testsuite name="QA Kit Feature"><directory>qa-kit/tests/Feature</directory></testsuite>
    <testsuite name="QA Kit Unit"><directory>qa-kit/tests/Unit</directory></testsuite>
  </testsuites>
  <source>
    <include>
      <directory>app</directory>
      <directory>packages/OMS/*/src</directory>
    </include>
  </source>
  <php>
    <ini name="error_reporting" value="24575"/>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_MAINTENANCE_DRIVER" value="file"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_STORE" value="array"/>
    <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_HOST" value="127.0.0.1"/>
    <env name="DB_PORT" value="3306"/>
    <env name="DB_DATABASE" value="oms_test"/>
    <env name="DB_USERNAME" value="root"/>
    <env name="DB_PASSWORD" value=""/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="PULSE_ENABLED" value="false"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
    <env name="OMS_TAX_RATE" value="10"/>
    <env name="OMS_LOGIN_THROTTLE" value="10000"/>
    <env name="OMS_API_THROTTLE" value="10000"/>
  </php>
</phpunit>
